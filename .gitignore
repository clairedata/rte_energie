# ==============================================================================
# .gitignore - EXCLUSION DES FICHIERS VOLUMINEUX & FICHIERS TEMPORAIRES
# ==============================================================================

# 1. Environnements virtuels Python (1.2+ Go)
.venv/
venv/
env/
ENV/

# 2. Dépendances & Builds Frontend Node.js (130+ Mo)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Caches Python et Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Données temporaires, sauvegardes volumineuses et modèles ML (>100MB)
data/backups/
data/raw/
*.sql
*.joblib
*.pkl
*.safetensors
*.pt
*.bin
models/

# 5. Fichiers journaux (logs)
logs/
*.log

# 6. Sorties de compilation dbt Core
dbt_energy/target/
dbt_energy/dbt_packages/
dbt_energy/logs/

# 7. Variables d'environnement locales & secrets
.env
.env.local
.env.*.local

# 8. Fichiers système et IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp